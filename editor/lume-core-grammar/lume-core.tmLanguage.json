{
  "name": "Lume Core",
  "scopeName": "source.lume.core",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#types"
    },
    {
      "include": "#statements"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lume",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lume",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lume",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lume"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lume"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.lume",
              "match": "\\\\[nrt0\\\\\"]"
            }
          ]
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.lume",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.lume",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.numeric.lume",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.lume",
          "match": "\\b(?:type|int|float|string|bool|Result)\\b"
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "name": "keyword.control.lume",
          "match": "\\b(?:return|if|else|while|for|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.lume",
          "match": "\\b(?:func|let|import|export)\\b"
        },
        {
          "name": "keyword.statement.lume",
          "match": "\\b(?:server|route|tool|get|head|post|put|patch|delete|options|verbs)\\b"
        },
        {
          "name": "keyword.other.lume",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lume",
          "match": "\\b(?:abs|bool|catalog|ceil|crypt_sha512|discovery_endpoints|el|env|exp|files|filter|float|floor|get|html|http_get|int|json|keys|len|ln|lock_file|log|map|max|mcps|min|mkdir|now|pow|print|push|put|range|read_file|reduce|render|replace|round|run|skills|sqrt|str|strftime|string|stringify|tools|try|unlock_file|write_file)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.lume",
          "match": "\\b(?:and|or|not)\\b|&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.lume",
          "match": "==|!=|<=|>=|<|>|=>|\\+|-|\\*|/|%|=|\\?"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.lume",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.lume",
          "match": "[,;:.()\\[\\]{}]"
        }
      ]
    }
  }
}
