{
  "name": "Lume",
  "scopeName": "source.lume",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#literals" },
    { "include": "#types" },
    { "include": "#statements" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.lume", "match": "//.*$" },
        { "name": "comment.block.lume", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lume",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.lume" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.lume" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.lume",
              "match": "\\\\[nrt0\\\\\"]"
            }
          ]
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.lume",
          "match": "\\b(?:true|false)\\b"
        },
        { "name": "constant.language.null.lume", "match": "\\bnull\\b" },
        {
          "name": "constant.numeric.lume",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.lume",
          "match": "\\b(?:type|int|float|string|bool|Result)\\b"
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "name": "keyword.control.lume",
          "match": "\\b(?:if|else|while|for|return|break|continue|try)\\b"
        },
        {
          "name": "keyword.declaration.lume",
          "match": "\\b(?:let|func|import|export)\\b"
        },
        {
          "name": "keyword.statement.lume",
          "match": "\\b(?:server|route|tool|verbs|run|mcps|skills)\\b"
        },
        {
          "name": "keyword.other.lume",
          "match": "\\b(?:as|in)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lume",
          "match": "\\b(?:print|str|len|keys|values|entries|get|put|json|stringify|now|int|float|bool|type|try|push|pop|insert|remove|map|filter|reduce|range|sum|min|max|sort|get_time|read_file|recall|remember|skill-run|fetch_url|sql_query|sql_schema|sql_tables|sql_write|tools|discovery_endpoints|calc)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.lume",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.operator.lume",
          "match": "==|!=|<=|>=|<|>|=>|\\+|-|\\*|/|%|=|\\?"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.lume",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.lume",
          "match": "[,;:.()\\[\\]{}]"
        }
      ]
    }
  }
}