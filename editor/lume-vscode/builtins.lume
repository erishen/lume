// ── 输出与类型转换 ──
// 输出到日志（运行时脱敏）
func print(value) {}

// 转字符串
func str(value) {}

// 转整数；解析失败回落 fallback（2026-09-27 起）
func int(value, fallback) {}

// 转浮点；解析失败回落 fallback
func float(value, fallback) {}

// 转布尔
func bool(value) {}

// 转字符串（与 str 同义）
func string(value) {}

// 值的可读序列化
func stringify(value) {}

// ── 集合操作 ──
// 长度（列表/映射/字符串）
func len(value) {}

// 映射的键列表
func keys(map) {}

// 映射取值，缺键回落 fallback
func get(map, key, fallback) {}

// 映射写值
func put(map, key, value) {}

// 列表追加（DSL 层）
func push(list, item) {}

// 整数区间 [start, end)
func range(start, end) {}

// 映射/列表变换
func map(list_or_map, fn) {}

// 过滤
func filter(list_or_map, fn) {}

// 归约
func reduce(list, fn, initial) {}

// ── JSON / 时间 / 环境 ──
// 解析 JSON 文本（失败置 VM error）
func json(text) {}

// 当前时间戳（秒）
func now() {}

// 读环境变量
func env(name) {}

// 时间戳格式化
func strftime(fmt, ts) {}

// ── 文件系统 ──
// 目录/文件清单
func files(path) {}

// 读文件（超时/不存在返回空）
func read_file(path) {}

// 写文件（原子写，0600）
func write_file(path, content) {}

// 建目录
func mkdir(path) {}

// flock 加锁（路径）
func lock_file(path) {}

// 解锁
func unlock_file(path) {}

// ── 数据库（sqlite / PG 后端） ──
// SQL 查询（sqlite/PG 后端）
