# ============================================================================
# 构建产物: make clean 全清,不入库。Makefile 的 build/ 与 bin/ 是 C 侧产物,
# tests/*-bin 由 make test 编出(dSYM 是 macOS 调试符号,同样可重编);
# build-asan/ 与 tests/*-asan 是 make asan 的独立构建产物。
# =============================================================================
build/
bin/
*.o
*.d
build-asan/
tests/smoke-bin
tests/smoke-bin.dSYM/
tests/tools-bin
tests/tools-bin.dSYM/
tests/smoke-bin-asan
tests/smoke-bin-asan.dSYM/
tests/tools-bin-asan
tests/tools-bin-asan.dSYM/

# --- 前端依赖与产物 ---------------------------------------------------------
# 源码在 frontend/src/;make ui 用 esbuild/Tailwind 把 bundle 与 CSS 写进
# ../www。pnpm-lock.yaml 入库以保证可复现(与 agent-httpd 同款约定)。
frontend/node_modules/
frontend/react-ssr/node_modules/
frontend/react-ssr/tailwind.css
# vscode 扩展的 vsix 包是 vsce package 产物,可重编,不入库。
editor/lume-vscode/dist/*.vsix
# www/ 里只有两类文件:手写的 HTML 壳(www/*/index.html、chat.html …)入库,
# React bundle / esbuild 分包 chunk / Tailwind 产物忽略。新增 www/ 下的
# 手写资源请用非 js/css 扩展名,或按下面的否定模式显式放行。
/www/**/*.js
/www/**/*.css
# React SSR 演示例外(与 agent-httpd 同款约定): www/js/home.js 是手写的
# 客户端参数回显脚本(无后端时降级页用),非可重编产物,显式放行入库。
/www/js/*
!/www/js/home.js
# rea 演示页例外: www/rea/ 下的 .js 是手写的页面脚本(CSP script-src 'self'
# 要求独立文件, 非 esbuild 可重编产物), 与 .html 一起入库。
/www/rea/*
!/www/rea/*.html
!/www/rea/*.js
# serena 演示页例外: 同 rea 模式, www/serena/ 下的 .js 是手写页面脚本。
/www/serena/*
!/www/serena/*.html
!/www/serena/*.js

# --- 运行时状态 -------------------------------------------------------------
# 含对话内容、会话 id 与本机绝对路径,一律不入库:
#   .data/        agent-httpd 会话与 MCP 注册(.data/sessions)
#   .sandbox/     fs MCP 沙箱根(MCP_FS_ROOT,见 .env.example)
#   skills/router llm-router 启动时同步的目录副本(拉 /v1/skills 落这里)
# 三者都在启动/同步时重建,删掉不影响仓库自洽性。
.data/
.sandbox/
skills/router/

# --- rea-demo 构建辅助下载物 -------------------------------------------------
# docker/ghidra-deps/(Ghidra 源码 zip + gradle + maven 依赖)、docker/ghidra/
# (Ghidra 发行包)、docker/jdk/ 都是宿主预下载的大体积构建依赖(单个 0.2-0.7GB,
# 共 ~1.4GB),不入库;clone 后重新构建时按 docker/ghidra-fetch-deps.sh 重新
# 获取。构建 context 需要它们,故仅 .gitignore 排除,不进 .dockerignore。
docker/ghidra-deps/
docker/ghidra/
docker/jdk/

# --- serena-demo 构建输入 --------------------------------------------------
# docker/serena-src/ 是构建前从宿主 /home/builder/Github/serena 复制进
# build context 的 Serena 源码(GPL-3.0, 仅本地演示用), 镜像内安装后即删,
# 不入库; 换机重构建时重新复制即可。
docker/serena-src/

# --- 宿主私有调试 wrapper ------------------------------------------------
# tools/rea-mcp-wrapper.sh 硬编码本机绝对路径(/Users/<user>/.nvm、.npm/_npx),
# 只对本机有效且暴露宿主环境信息, 不入库; 本机调试需要时保留工作区文件,
# 换机重装 rea 后路径会变, 该文件无法复用。
tools/rea-mcp-wrapper.sh

# --- 运行日志 ---------------------------------------------------------------
# 访问日志由 agent-httpd 直接写 ./logs/access.log,是纯流量记录。
logs/
*.log

# --- 密钥 ------------------------------------------------------------------
# Repo 级忽略:靠本机 ~/.gitignore_global 兜不住换 checkout / CI 场景,
# 这里显式忽略所有 .env 变体,再单独放行模板。
.env
.env.*
!.env.example
!*.env.example
# Basic Auth 密码只在 .env(上面的规则已覆盖);htpasswd 由镜像 entrypoint
# 在容器内从 .env 现场生成,不落宿主,所以这里没有第二个凭据文件要忽略。
# 见 docker/entrypoint.sh 与 docker/docker-compose.yml「访问控制」。

# --- macOS 噪声 -------------------------------------------------------------
.DS_Store
._*
.venv-sqlite/
.tmpbuild/
