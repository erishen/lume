// tests/for-scope.lume —— for-init 子作用域 (core P1-3) 运行时单测。
// 经典 for 整体(init/cond/body/incr)活在自己的子作用域里: 兄弟循环可以
// 同名 (C99 语义), 循环结束后 init 变量不可见; for-init 不得遮蔽外层
// 同名函数局部 (负例在 run_all.sh 2d 用 --check 拒绝)。for-in 迭代变量
// 是「绑定复用」, 语义保持。
// 运行: ./bin/lume tests/for-scope.lume
// 期望输出以 "for-scope ok N" 结尾。

let st = { pass: 0, fail: 0 };
let count = 0;

func expect(name, got, want) {
  if (got == want) {
    st.pass = st.pass + 1;
  } else {
    st.fail = st.fail + 1;
    print("FAIL " + name + "  got=" + str(got) + "  want=" + str(want));
  }
}

// 1. 兄弟循环同名 (C99 语义): 各自独立运行, init 互不干扰
let s = "";
for (let i = 0; i < 3; i = i + 1) { s = s + str(i); }
expect("sibling loop 1", s, "012"); count = count + 1;
s = "";
for (let i = 0; i < 2; i = i + 1) { s = s + str(i); }
expect("sibling loop 2", s, "01"); count = count + 1;

// 2. 循环结束后 init 变量不可见: 外层同名绑定不被污染
let j = 99;
for (let jj = 0; jj < 1; jj = jj + 1) { s = "in-" + str(jj); }
expect("outer j untouched", j, 99); count = count + 1;

// 3. 循环结束后作用域已恢复: 同名 let 可在循环后声明 (init 未泄漏)
for (let m = 0; m < 1; m = m + 1) { }
let m = 42;
expect("let after loop same name", m, 42); count = count + 1;

// 4. 函数内 for-init 遮蔽内置名 (检查到 fn_root 停, 允许)
func f() {
  let seen = 0;
  for (let pi = 0; pi < 1; pi = pi + 1) { seen = pi; }
  return seen;
}
expect("shadow builtin pi in func", f(), 0); count = count + 1;

// 5. for-in 兄弟同名 (绑定复用, 语义保持)
let xs = "";
for (x in [1, 2]) { xs = xs + str(x); }
for (x in [3]) { xs = xs + str(x); }
expect("for-in sibling reuse", xs, "123"); count = count + 1;

if (st.fail > 0) {
  print("for-scope FAILED (" + str(st.fail) + " of " + str(count) + ")");
} else {
  print("for-scope ok " + str(count));
}
