// Lume example: a complete "SSR content page" — the server-side counterpart
// of agent-httpd's preset React fallback pages (www/react/*.html), rendered
// by the Lume engine itself instead of by react-dom/server.
//
//   make && bin/lume examples/ssr-content.lume    (or: make ssr-content)
//   browse:
//     http://localhost:8085/                           — the article page
//     http://localhost:8085/params?name=Ada&flag       — GET 参数回显
//     (or submit the form below the params table — a GET form posts to
//      /params the same way agent-httpd's react-ssr.cgi form does)
//
// What makes this page "SSR": the initial HTML returned by GET / already
// contains the full article — title, paragraphs, list, table, code block.
// No JavaScript is needed to read it; `curl localhost:8085/ | head -20`
// shows the content in the response. Compare that with the CSR shells
// under www/ (a "loading…" placeholder plus a JS bundle), and with
// agent-httpd's preset pages, where a C server serves static HTML and a
// CGI renders on submit. All of it is SEO-friendly too: title, description
// and OpenGraph tags are server-rendered into the head.

type Reply = {
  status: int,
  type: string,
  body: string,
};

server {
  host = "127.0.0.1";
  port = 8085;
  docroot = "./www";   // shared docroot; this demo itself needs no assets
}

// ------------------------------------------------ page shell (SSR)
func cls(active: string, name: string): string {
  let c: string = "nav";
  if (active == name) { c = c + " active"; }
  return c;
}

func nav(active) {
  return el("nav", {},
    el("a", { class: cls(active, "home"), href: "/" }, "内容页"),
    el("a", { class: cls(active, "params"), href: "/params" }, "参数回显"));
}

// title / desc are fixed copy (escaped as scalars by html()); body is a
// vnode list rendered structurally — same shell pattern as demo.lume.
func page(title, page_id, desc, body) {
  return html("<!doctype html><html lang='zh-CN'><head>"
    + "<meta charset='utf-8'>"
    + "<meta name='viewport' content='width=device-width, initial-scale=1'>"
    + "<title>{0} · Lume</title>"
    + "<meta name='description' content='{1}'>"
    + "<meta property='og:title' content='{0} · Lume'>"
    + "<meta property='og:description' content='{1}'>"
    + "<meta property='og:type' content='website'>"
    + "<style>"
    + "body{font-family:ui-sans-serif,system-ui,-apple-system,'PingFang SC',sans-serif;"
    + "margin:0;background:#0f1420;color:#e2e8f0;line-height:1.6}"
    + ".wrap{max-width:720px;margin:0 auto;padding:32px 20px 48px}"
    + ".nav{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid #334155;margin-bottom:24px}"
    + ".nav a{color:#94a3b8;text-decoration:none;font-size:14px}"
    + ".nav a.active{color:#38bdf8;font-weight:700}"
    + "h1{font-size:32px;margin:8px 0 4px;background:linear-gradient(90deg,#38bdf8,#a78bfa);"
    + "-webkit-background-clip:text;background-clip:text;color:transparent}"
    + "h2{font-size:20px;margin:28px 0 8px;color:#7dd3fc}"
    + "p{font-size:15px;color:#cbd5e1;margin:8px 0}"
    + "li{font-size:15px;color:#cbd5e1;margin:4px 0}"
    + "code{background:#1c2536;border-radius:4px;padding:2px 6px;color:#fbbf24;"
    + "font-family:ui-monospace,Menlo,monospace;font-size:13px}"
    + "pre{background:#1c2536;border:1px solid #334155;border-radius:10px;padding:14px;overflow:auto}"
    + "pre code{background:none;padding:0}"
    + "table{width:100%;border-collapse:collapse;margin:12px 0}"
    + "th,td{text-align:left;padding:8px 10px;font-size:14px;border-bottom:1px solid #334155}"
    + "th{color:#94a3b8;font-size:12px;text-transform:uppercase;letter-spacing:.06em}"
    + "td{color:#e2e8f0}"
    + ".hero{padding:32px 0 8px}"
    + "footer{color:#64748b;font-size:13px;text-align:center;padding:24px 0}"
    + ".pill{display:inline-block;background:#34d399;color:#022c22;border-radius:9999px;"
    + "padding:2px 12px;font-size:11px;font-weight:700;letter-spacing:.08em;margin-bottom:12px}"
    + "input{width:100%;border-radius:8px;border:1px solid #334155;background:#0f1420;"
    + "padding:8px 12px;color:#e2e8f0;font:inherit;outline:none}"
    + "input:focus{border-color:#38bdf8}"
    + "button{margin-top:16px;font:inherit;font-weight:700;cursor:pointer;border:none;"
    + "border-radius:8px;padding:10px 20px;background:#38bdf8;color:#082f49}"
    + "</style>"
    + "</head><body data-page='{2}'>"
    + "{3}"
    + "<main class='wrap'>{4}</main>"
    + "<footer>Lume · SSR 内容页演示 · :8085</footer>"
    + "</body></html>",
    title, desc, page_id, nav(page_id), body);
}

// ------------------------------------------------ the article page
route "GET", "/", func (req) {
  return page("服务端渲染的内容页", "home",
    "Lume SSR 示例：初始 HTML 即含完整正文的网页，无需 JavaScript 即可阅读全文。", [
    el("section", { class: "hero" },
      el("span", { class: "pill" }, "SSR"),
      el("h1", {}, "这页在服务器上就渲染完了"),
      el("p", {}, "这一页不是空壳——初始 HTML 响应里就带着完整正文：标题、段落、列表、"
        + "表格、代码块都在。浏览器拿到即见，搜索引擎和分享抓取同样可见。")),
    el("section", {},
      el("h2", {}, "这一页是怎么渲染的"),
      el("p", {}, "Lume 引擎直接执行本文件，用 <code>el()</code> / <code>html()</code> "
        + "构建组件树，<code>render()</code> 序列化成 HTML 输出。没有任何 "
        + "<code>react-dom/server</code> 参与，也不需要 Node 运行时。"),
      el("h2", {}, "三种渲染方式对照"),
      el("ul", {},
        el("li", {}, "本页：Lume 原生 SSR——初始 HTML 即完整内容"),
        el("li", {}, "www/ 下应用：CSR 壳——空 <code>root</code> + 客户端 bundle"),
        el("li", {}, "agent-httpd 预设页：静态 HTML 降级页，表单提交由 CGI 渲染")),
      el("h2", {}, "SSR vs CSR"),
      el("table", {},
        el("tr", {}, el("th", {}, "维度"), el("th", {}, "本页 (SSR)"), el("th", {}, "www/ 壳 (CSR)")),
        el("tr", {}, el("td", {}, "初始 HTML 内容"), el("td", {}, "完整正文"), el("td", {}, "loading… 占位")),
        el("tr", {}, el("td", {}, "读内容需要 JS"), el("td", {}, "否"), el("td", {}, "是")),
        el("tr", {}, el("td", {}, "SEO / 分享抓取"), el("td", {}, "直接可见"), el("td", {}, "空壳，需 noindex 或 OG")),
        el("tr", {}, el("td", {}, "首屏"), el("td", {}, "即时"), el("td", {}, "等 bundle 下载+执行"))),
      el("h2", {}, "验证"),
      el("p", {}, "内容在响应里，curl 就能读到："),
      el("pre", {}, el("code", {},
        "$ curl -s localhost:8085/ | head -20\n"
        + "<!doctype html>\n"
        + "<html lang='zh-CN'><head>…\n"
        + "<title>服务端渲染的内容页 · Lume</title>\n"
        + "…完整正文已在 HTML 中…"))),
  ]);
};

// ------------------------------------------------ GET 参数回显页
// The counterpart of agent-httpd's "Received GET parameters" card: raw
// query string + decoded params. Values are escaped as scalars through
// html() slots, so ?name=<script>… stays text.
route "GET", "/params", func (req) {
  let name = get(req.query_params, "name", "未提供");
  let flag = get(req.query_params, "flag", "未提供");
  let msg = get(req.query_params, "message", "未提供");
  return page("参数回显", "params",
    "Lume SSR 示例：req.query 原始查询串与解码后的参数表。", [
    el("section", { class: "hero" },
      el("span", { class: "pill" }, "GET"),
      el("h1", {}, "收到的 GET 参数"),
      el("p", {}, "来自请求 map 的 <code>req.query</code>（原始串，无 <code>?</code>）与 "
        + "<code>req.query_params</code>（URL 解码 map：<code>+</code>→空格、"
        + "<code>%XX</code>→字节、重复 key last-wins）。")),
    el("section", {},
      el("pre", {}, el("code", {}, "req.query = " + str(req.query))),
      el("table", {},
        el("tr", {}, el("th", {}, "Key"), el("th", {}, "Value")),
        el("tr", {}, el("td", {}, "name"), el("td", {}, name)),
        el("tr", {}, el("td", {}, "flag"), el("td", {}, flag)),
        el("tr", {}, el("td", {}, "message"), el("td", {}, msg))),
      el("p", {}, "试试 <code>/params?name=Ada&flag&message=hello%20world</code>，"
        + "或提交下面的表单（GET 提交到本页，等同 agent-httpd 预设页的 "
        + "<code>react-ssr.cgi</code> 表单）。"),
      el("form", { method: "get", action: "/params" },
        el("label", {}, "name",
          el("input", { name: "name", placeholder: "Ada" })),
        el("label", {}, "message",
          el("input", { name: "message", placeholder: "hello world" })),
        el("button", { type: "submit" }, "提交")),
    ),
  ]);
};

print("ssr-content.lume: SSR content page on :8085 ...");
run();
