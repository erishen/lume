// ============================================================================
// sqlite-write.lume —— 原生 SQLite 写能力演示(与 invest 的只读默认对照)
//
// 这个 profile 显式放行 sql_write,展示"模型建分析表 → 写入 → 查询"的完整
// 链路。护栏与 invest 相同(agent-httpd src/agent/sqlite_tool.c):
//   - sql_query :  只读 SELECT(SQLITE_OPEN_READONLY 物理只读)
//   - sql_write :  INSERT / UPDATE / DELETE(必须带 WHERE)或新建表的
//                  CREATE TABLE;DROP/ALTER/TRUNCATE/VACUUM/ATTACH/PRAGMA/
//                  GRANT/REVOKE 与任何触碰 portfolio 镜像表的语句一律拒绝
//   - sql_tables / sql_schema : introspect
//
// 启动方式(make 目标注入 HARNESS_TOOLS_ALLOW + SQLITE_DB,不要裸跑):
//   make demo-sqlite          # 构建 + 同步账本镜像 + 清端口 + 前台启动
//   make demo-sqlite-watch    # 热更新版(改本文件自动重起)
//   然后浏览器开 http://localhost:8084/chat ,把下面任一问题粘进聊天框:
//
//     "建一张 analysis 表存每只持仓的成本市值(symbol, cost_value 两列),
//      把数据写进去,再查出来给我"
//     "把 analysis 表里 AAPL 的市值改成 2000,再查出来"
//     "试着 DROP 掉 analysis 表"(应被护栏拒绝,回答说明原因)
//
// 只读对照:make invest(8082)默认不含 sql_write —— 需要模型建分析表的
// 场景才放行。SQLITE_DB 指向镜像库 .data/lume.db,每次启动由
// tools/sqlite-migrate.py 从 .data/portfolio.json 幂等重灌(portfolio 表只读)。
//
// DSL 直连示例(本文件下方 /dsl 路由):除 chat 工具外,脚本层也可直接查/写
// 同一个库 —— sql_query / sql_write 内建(2026-09-25 新增):
//   sql_query(sql) / sql_query(path, sql)   只读 SELECT → 行 map 列表
//   sql_write(sql) / sql_write(path, sql)   护栏写 → 影响行数(DDL 为 0)
// 单参形式用环境变量 SQLITE_DB(make demo-sqlite 已注入 .data/lume.db);
// 护栏与 chat 工具同源(单语句、SELECT-only 物理只读、UPDATE/DELETE 必须带
// WHERE、DROP/ALTER/PRAGMA 与 portfolio 镜像表拒绝),代码只此一份。
// ============================================================================

server {
  port = 8084;
  workers = 2;
  bind = "127.0.0.1";   // 只绑回环,不向局域网暴露
  docroot = "./www";
  views = "sqlite-write"; // 独立演示 UI(www/sqlite-write/chat.html,自包含 SSE 聊天页,
                          // 不复用 invest 前端;/ → /chat)
  htpasswd   = env("HTPASSWD_FILE");   // 未设 = 认证关闭(本机演示)
  auth_realm = "lume";
}

// 演示页面:聊天页由 views=sqlite-write 提供(www/sqlite-write/chat.html),
// 自包含 CSS+JS,直接连 /react/api/chat 的 SSE 循环,不依赖 invest 的 React
// bundle。根路径跳到 /chat。
route "GET", "/", func(req) {
  return { status: 302, type: "text/plain", body: "/chat" };
};

// ============================================================================
// DSL 直连示例 —— 不经过 LLM,脚本直接查/写 SQLite(与 chat 工具同一个库、
// 同一套护栏)。浏览器开 http://localhost:8084/dsl 看可视化页面,
// /dsl/data 返回同一份数据的原始 JSON。
// ============================================================================

// 幂等建 analysis 表并写入演示数据(重复启动不报错:表已存在则跳过)
func seed_analysis() {
  let has = len(sql_query(
    "select name from sqlite_master where type = 'table' and name = 'analysis'"));
  if (has == 0) {
    sql_write("create table analysis (symbol text, cost_value real, note text)");
    sql_write("insert into analysis values ('AAPL', 1500, 'dsl-demo')");
    sql_write("insert into analysis values ('NVDA', 900, 'dsl-demo')");
  }
}

// 行 map 列表 → HTML 表格(SSR:el/render,数据全部来自 sql_query)
func sql_table(rows, cols) {
  let heading = el("tr", {}, map(func(c) { return el("th", {}, c); }, cols));
  let trs = map(func(r) {
    return el("tr", {}, map(func(c) { return el("td", {}, str(get(r, c))); }, cols));
  }, rows);
  return el("table", {}, heading, trs);
}

let dsl_example =
  "// 只读查询 → 行 map 列表,可 get()/len()/遍历\n" +
  "let holdings = sql_query(\"select symbol, units, avg_cost from portfolio order by symbol\");\n" +
  "\n" +
  "// 护栏写 → 影响行数(DDL 为 0);UPDATE/DELETE 必须带 WHERE\n" +
  "let n = sql_write(\"update analysis set cost_value = 2000 where symbol = 'AAPL'\");\n" +
  "\n" +
  "// 幂等建表:表存在则跳过(重复启动不报错)\n" +
  "let has = len(sql_query(\"select name from sqlite_master where type = 'table' and name = 'analysis'\"));\n" +
  "if (has == 0) {\n" +
  "  sql_write(\"create table analysis (symbol text, cost_value real, note text)\");\n" +
  "  sql_write(\"insert into analysis values ('AAPL', 1500, 'dsl-demo')\");\n" +
  "}";

// 可视化页面:portfolio 只读查询 + analysis 表往返,合并成一个 HTML 响应。
route "GET", "/dsl", func(req) {
  seed_analysis();
  let holdings = sql_query(
    "select symbol, units, avg_cost from portfolio order by symbol");
  let analysis = sql_query("select * from analysis order by symbol");
  return {
    status: 200,
    type: "text/html; charset=utf-8",
    body: render(
      el("html", {},
        el("head", {},
          el("meta", { charset: "utf-8" }),
          el("title", {}, "Lume · DSL 直连 SQL 演示")),
        el("body", {},
          el("h1", {}, "DSL 直连 SQL 演示"),
          el("p", {},
            "脚本层 ", el("code", {}, "sql_query"), " / ",
            el("code", {}, "sql_write"), " 内建直接查/写 SQLite,不经过 LLM。"),
          el("h2", {}, "写法示例(脚本层直接调用,不经 LLM)"),
          el("pre", {}, dsl_example),
          el("h2", {}, "portfolio 镜像表(只读查询)"),
          sql_table(holdings, ["symbol", "units", "avg_cost"]),
          el("p", {}, "共 " + str(len(holdings)) + " 行"),
          el("h2", {}, "analysis 表(DSL 幂等建表 + 写入)"),
          sql_table(analysis, ["symbol", "cost_value", "note"]),
          el("p", {}, el("a", { href: "/dsl/data" }, "查看原始 JSON")))))
  };
};

// 同一份数据的原始 JSON(供脚本/接口消费)
route "GET", "/dsl/data", func(req) {
  seed_analysis();
  let holdings = sql_query(
    "select symbol, units, avg_cost from portfolio order by symbol");
  let analysis = sql_query("select * from analysis order by symbol");
  return { status: 200, type: "application/json", body: stringify({
    holdings: holdings,
    analysis: analysis,
    row_count: len(holdings),
  }) };
};

print("sqlite-write.lume: on :8084 — 打开 /chat,问\"建一张 analysis 表存持仓成本市值\"试试");
print("  DSL 直连示例:打开 /dsl(可视化)/dsl/data(JSON),看 sql_query/sql_write 内建直接查/写同一个库");
run();
