// ============================================================================
// invest.lume —— 投资助手产品服务器(替代 hello.lume 作为 8082 日常驱动)
//
// 启动方式:在 lume 目录运行 make invest(或 make invest-watch 热更新)。
//   不要直接 ./bin/lume 跑这个文件 —— HARNESS_SKILLS_ALLOW /
//   HARNESS_TOOLS_ALLOW / MCP_ALLOW 只在 make 目标里注入;直跑会让整份
//   技能/工具/MCP 目录对聊天页可见(启动时会打印告警,见文件末尾)。
// 页面:  /(仪表盘)  /chat(聊天)  /reports(周报归档)  /settings(设置)
// 静态层分层:页面壳 + 自家 bundle 在 www/invest/(views 前端);共享的
// /invest/app.js(聊天 bundle)、/app.css(壳样式)、/chunk-*.js(React 分包,
// esbuild 把共享 React 抽成一个 chunk,全部页面首访后逐页复用)在 docroot
// 下。URL 保持根路径不变。
//
// 产品 API(GET+/POST /api/settings、GET /api/reports…)由 C 侧 iquest 模块
// 在 run() 时注册(src/iquest.c),这里不需要再声明路由。
//
// 权限边界(知情提示):聊天页的模型经白名单工具可以<b>直接写账本</b>
// (portfolio_add/remove)并<b>触发本地管线</b>(portfolio-check 在 asset-lens
// 跑 make、pse-review 跑 autogen-pse 三角色)。写操作有 flock 锁 + 原子写
// 兜底(不会损坏/丢失文件),但对话内容本身不可信 —— 不要向不受信方透露
// 账本或 .env 内容。
// ============================================================================

server {
  port = 8082;
  workers = 2;
  // 只绑回环:本机仪表盘/聊天不向局域网暴露(此前 README 的 127.0.0.1 保护
  // 只覆盖 compose 容器,本地 make invest 默认 0.0.0.0 会让 LAN 裸奔)。
  // 需要对外提供时改成 bind = "0.0.0.0" 或删掉该行。
  bind = "127.0.0.1";
  docroot = "./www";
  views = "invest";   // docroot 下的页面子目录:/ → www/invest/index.html 等
                      // (URL 仍然 /、/chat、/reports.html、/settings.html)
  // 访问控制: 服务端本身无鉴权, /api/reports 与 /react/api/chat 都是未认证
  // 端点(聊天里还能经 fs 工具读写文件)。htpasswd 走 env, 本机 make invest
  // 时未设 → null → 认证保持关闭(不会把自己锁在外面); 容器内由 compose 注入
  // HTPASSWD_FILE=/app/auth/htpasswd 才启用 Basic Auth。框架只认 $5$/$6$/
  // bcrypt 强哈希, 明文与弱哈希在加载时直接拒绝。
  htpasswd   = env("HTPASSWD_FILE");
  auth_realm = "lume";
}

// ------------------------------------------------ 投资账本(产品领域层)
// tsm-hub/网关给的是通用传输工具(fetch_url、get_time、query_exchange_rate、
// recall/remember、skill-run…),不认识「持仓」是什么。持仓记账与周报生成是
// 这个示例自己的领域逻辑,所以在这里以 DSL `tool` 声明,而不是经 execute_code
// 之类的无类型逃生舱搬走 —— typed 参数会同时生成 /catalog 的 OpenAI schema,
// 缺参会零值兜底, 类型检查在编译期完成, 而 execute_code 的空 schema 全丢了。
//
// 持久化: 私家账本落 .data/portfolio.json(与 MCP 同步产物同目录,已被
//   .gitignore 排除)。location 刻意不挂在 sandbox 里 —— fs MCP 的
//   MCP_FS_ROOT 只有 .sandbox, 沙箱内的工具永远够不到 .data, 领域状态只应
//   经 Lume 层访问。写采用整文件 stringify+write_file(演示级, 非原子)。
//
// 白名单: 本地 tool 同样被 HARNESS_TOOLS_ALLOW 过滤(tools_register_allowed
//   对 builtins + DSL + MCP 统一生效),所以这套工具还要登入 Makefile 的
//   INVEST_TOOLS 与 docker/docker-compose.yml 的 invest HARNESS_TOOLS_ALLOW,
//   否则会像曾经的 add 一样被静默丢弃(只有一行 stderr)。
//
// 行情: report_generate 接受可选的 prices { symbol: float }; LLM 可以先用
//   query_exchange_rate / fetch_url 取到现价再传入,不传则按成本计价并在报告
//   里明说口径,避免把「快照成本」冒充「实时市值」。
// ============================================================================
let portfolio_file = ".data/portfolio.json";
let portfolio_lock = ".data/.portfolio.lock";   // flock 锁文件(常驻,进程死自动释放)

func load_portfolio() {
  let raw = read_file(portfolio_file);
  if (raw == null) { return { holdings: {} }; }
  let data = json(raw);
  if (data == null) {
    // 文件存在但解析失败 = 内容损坏(理论上 write_file 原子写后不会发生;
    // 可能是手工改坏)。显式告警而不是静默当空账本 —— 下次 save 会覆盖它。
    print("警告: " + portfolio_file + " 解析失败(内容损坏?)——按空账本继续,保存会覆盖该文件");
    return { holdings: {} };
  }
  return data;
}

func save_portfolio(p) {
  mkdir(".data");
  write_file(portfolio_file, stringify(p));
}

// ------------------------------------------------ 聊天工具(领域工具,非 demo)
// 前端 chat 页沿用 POST /react/api/chat SSE;技能/工具由框架从环境发现。
// portfolio_get: 只读快照(GET 侧),返回按代码归组的账本副本。
tool "portfolio_get", "返回本地投资账本的持仓快照:每个 symbol 一条 {name, units, avg_cost}, 以及记录更新时间。只读,无副作用。", {}, (arg) => {
  let p = load_portfolio();
  return {
    ok: true,
    updated: get(p, "updated", 0),
    count: len(keys(get(p, "holdings", {}))),
    holdings: get(p, "holdings", {}),
  };
};

// portfolio_add: 记录一次买入,按 symbol 归组;已存在时按加权平均合并均价
// (units 相加, avg_cost = 新旧成本合计 / 新总量)。name 传空串则保留旧名。
// 写路径加 flock 锁(lock_file/unlock_file):workers>1 时两个并发请求的
// 读-改-写若不串行会互相覆盖、静默丢一笔更新。锁等 3 秒拿不到就报错让
// 用户重试,而不是无锁覆盖。
tool "portfolio_add", "记录/更新一次买入:按 symbol 归组,已存在则合并成加权均价。参数 units(数量,float)、avg_cost(买入均价,float)、name(自定义名,可选,空串保留旧名)。", { symbol: string, units: float, avg_cost: float, name: string }, (arg) => {
  let sym = arg.symbol;
  if (sym == "") { return { err: "symbol 不能为空" }; }
  if (arg.units <= 0 or arg.avg_cost < 0) {
    return { err: "units 必须 > 0, avg_cost 必须 >= 0" };
  }
  if (not lock_file(portfolio_lock, 3000)) {
    return { err: "账本写锁超时(另一请求正在写),请稍后重试" };
  }
  let p = load_portfolio();
  let h = get(p, "holdings", {});
  let cur = get(h, sym, null);
  if (cur == null) {
    put(h, sym, { name: arg.name, units: arg.units, avg_cost: arg.avg_cost });
  } else {
    let new_units = cur.units + arg.units;
    cur.avg_cost = (cur.units * cur.avg_cost + arg.units * arg.avg_cost) / new_units;
    cur.units = new_units;
    if (arg.name != "") { cur.name = arg.name; }
  }
  put(p, "holdings", h);
  put(p, "updated", now());
  save_portfolio(p);
  unlock_file();
  let after = get(h, sym, null);
  return { ok: true, symbol: sym, units: after.units, avg_cost: after.avg_cost };
};

// portfolio_remove: 整仓删除(清仓记账),返回被删的持仓与剩余只数。同样持
// 账本写锁(见 portfolio_add 注释)。
tool "portfolio_remove", "从账本删除一个持仓(整仓清仓记账)。参数 symbol(代码)。", { symbol: string }, (arg) => {
  let sym = arg.symbol;
  if (not lock_file(portfolio_lock, 3000)) {
    return { err: "账本写锁超时(另一请求正在写),请稍后重试" };
  }
  let p = load_portfolio();
  let h = get(p, "holdings", {});
  let old = get(h, sym, null);
  if (old == null) {
    unlock_file();
    return { err: "账本里没有持仓 " + sym };
  }
  let out = {};
  let syms = keys(h);
  let i = 0;
  while (i < len(syms)) {
    let k = get(syms, i);
    if (k != sym) { put(out, k, get(h, k, null)); }
    i = i + 1;
  }
  put(p, "holdings", out);
  put(p, "updated", now());
  save_portfolio(p);
  unlock_file();
  return { ok: true, removed: sym, units: old.units, avg_cost: old.avg_cost, remaining: len(keys(out)) };
};

// report_generate: 把账本落成一篇 Markdown 周报并写入 iquest 归档目录,
// 仪表盘 /reports 即可列出。不要求 LLM 回环 —— 这是本地确定性计算。
func report_body(p, prices, prices_ok) {
  let h = get(p, "holdings", {});
  let syms = keys(h);
  let i = 0;
  let cost_total = 0.0;
  let value_total = 0.0;
  let max_sym = "";
  let max_value = -1.0;
  let missing = 0;   // 传入的 prices 里没有现价的 symbol 数(按成本计)
  let rows = "";
  while (i < len(syms)) {
    let sym = get(syms, i);
    let cur = get(h, sym, null);
    if (cur != null) {
      let units = cur.units;
      let unit_cost = cur.avg_cost;
      let cost = units * unit_cost;
      let px = null;
      if (prices_ok) { px = get(prices, sym, null); }
      let value = cost;
      let px_str = "—(按成本)";
      if (px != null) { value = px * units; px_str = str(px); }
      else { missing = missing + 1; }
      cost_total = cost_total + cost;
      value_total = value_total + value;
      if (value > max_value) { max_value = value; max_sym = sym; }
      rows = rows + "| " + sym + " | " + str(units) + " | " + str(unit_cost)
             + " | " + px_str + " | " + str(value) + " |\n";
    }
    i = i + 1;
  }
  let pnl = value_total - cost_total;
  let sign = "";
  if (pnl >= 0) { sign = "+"; }
  // 口径如实标注:prices 只覆盖部分 symbol 时,缺现价的按成本计,不能统一
  // 写"按实时行情"(混合口径下集中度/盈亏数值同样以本口径为准)。
  let pricing = "按买入成本计价(未提供当前行情)";
  if (prices_ok) {
    if (missing == 0) { pricing = "按传入的当前行情计价"; }
    else { pricing = "按传入的当前行情计价, " + str(missing) + " 项无现价按成本计价"; }
  }
  let conc = "—";
  if (max_sym != "" and value_total > 0) {
    conc = max_sym + " " + str(100.0 * max_value / value_total) + "%";
  }
  return "# 投资周报 · 本地账本\n\n"
    + "- 生成时间: " + strftime("%Y-%m-%d %H:%M", now()) + "\n"
    + "- 计价口径: " + pricing + "\n"
    + "- 持仓数: " + str(len(syms)) + "\n\n"
    + "## 组合总览\n\n"
    + "| 指标 | 数值 |\n|---|---|\n"
    + "| 总成本 | " + str(cost_total) + " |\n"
    + "| 总市值 | " + str(value_total) + " |\n"
    + "| 浮动盈亏 | " + sign + str(pnl) + " |\n"
    + "| 最大单一持仓 | " + conc + " |\n\n"
    + "## 持仓明细\n\n"
    + "| 代码 | 数量 | 均价 | 现价 | 市值 |\n|---|---|---|---|---|\n"
    + rows + "\n"
    + "> 本地自动生成:数据仅来自私家账本,行情口径见上,不代表投资建议。\n";
}

tool "report_generate", "把本地投资账本生成一份 Markdown 周报(组合总览/持仓明细/集中度/盈亏)并写入归档目录,返回报告全文与文件路径。可选 prices: { symbol: float } 当前价,提供则以实时口径计价。", { prices: { symbol: float } }, (arg) => {
  let p = load_portfolio();
  let prices = get(arg, "prices", null);
  let prices_ok = (prices != null);
  mkdir(".data/reports");
  let dir = env("IQUEST_REPORTS_DIR");
  if (dir == null or dir == "") { dir = ".data/reports"; }
  // 文件名带时分,同一天多次生成不再互相覆盖(归档按"每周一篇"语义保留历史)。
  let file = dir + "/lume-tool__weekly_review_" + strftime("%Y%m%d_%H%M", now()) + ".md";
  let md = report_body(p, prices, prices_ok);
  let wrote = write_file(file, md);
  if (not wrote) { return { err: "写入报告失败: " + file }; }
  return { ok: true, file: file, bytes: len(md), report: md };
};

// ------------------------------------------------ /discovery
// 启动时 LLM-router 集成发现到的工具/技能/MCP 一览(GET,跑在 master VM)。
get "/discovery", (req) => {
  return {
    endpoints: discovery_endpoints(),   // 只报配置状态与模型名, 不暴露内网 URL,
    skills: skills(),
    tools: tools(),
    mcps: mcps(),
  };
};

// 白名单守门:HARNESS_* 只由 make invest 注入;直跑 ./bin/lume 时 harness
// 不收敛,整份技能/工具/MCP 目录都会出现在聊天页里。这里显式告警,免得误
// 以为已经收敛(启动打印在服务 listen 之前)。
if (env("HARNESS_SKILLS_ALLOW") == null or env("HARNESS_SKILLS_ALLOW") == "") {
  print("警告: 未设置 HARNESS_SKILLS_ALLOW —— 请用 `make invest` 启动以收敛白名单");
};

run();   // 启动服务器并阻塞(iQuest API 在此 fork 前注册)