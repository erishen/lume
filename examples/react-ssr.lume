// React SSR 内容页 demo —— lume 直接对接常驻的 node React SSR 后端(无 CGI)。
//
//   server { react_socket = "...sock" }  → 内嵌 agent-httpd 把 /react/*
//                                          FastCGI relay 到该 UNIX socket
//   node bin/react-ssr-server <sock>     → 常驻 node 进程:React 组件经
//                                          react-dom/server renderToString
//                                          渲染成完整 HTML(不 fork 进程)
//
// 链路:
//   GET /react                → FastCGI relay → node React SSR(完整 HTML,
//                                react-router StaticRouter 多页: /react/about
//                                /react/counter /react/chat 都渲染)
//   无后端时                   → 降级伺服 docroot 静态页 www/react/home.html
//   GET /js/react-ssr.js      → docroot 静态 bundle(客户端 hydration)
//
// 依赖: node + react-ssr 构建链(frontend/react-ssr/ 页面源码 + scripts/
// build-react-ssr.sh → agent-httpd/bin/react-ssr-server)。make react-ssr 会
// 自动构建并先后端后前端启动;直接手动跑:先起后端,再起本文件。
server {
  host = "127.0.0.1";
  port = 8085;
  docroot = "./www";
  react_socket = "./.data/react-ssr.sock";   // 常驻 node React SSR 后端
}
run();
