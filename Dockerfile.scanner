# syntax=docker/dockerfile:1
# ============================================================================
# lume-scanner base —— 从 release 取 lume 静态二进制, 不再源码重编。
#
# 为什么之前要重编: scanner 依赖 kdj/atr/obv/williams_r + RSI/MACD/布林/
# 绩效风险共 23 个金融内建, 而当时能用的 release(v0.6.3) 缺其中一部分,
# 跑 /api/indicators 会 "undefined variable kdj"。
#
# 现在这些内建都已发布。实测 v0.12.1 的 release 静态包逐个真实调用 23 个
# 内建(按 scanner 源码里的实际签名), 全部通过 —— 所以不再需要重编。
# 顺带的好处: 构建从"编译整个 C 树"变成"下载 + 解压", 且版本可查可校验;
# 源码重编拿到的是当前工作树, 同一个 Dockerfile 在不同日子产出不同二进制。
#
# 构建上下文 = work/lume/lume/。默认路径(LUME_LOCAL=0)其实只需要网络,
# 不再读上下文里的 C 源码; 保留上下文是为了 LUME_LOCAL=1 的源码重编回退。
# ============================================================================

# ---------- lume 二进制: 从 release 取 ----------
ARG LUME_VERSION=v0.13.0
ARG LUME_REPO=erishen/lume

FROM alpine:3.20 AS lume-fetch
ARG LUME_VERSION
ARG LUME_REPO
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH:-arm64}" in \
      amd64) carch=x64 ;; \
      arm64) carch=arm64 ;; \
      *) echo "unsupported TARGETARCH='${TARGETARCH}'" >&2; exit 1 ;; \
    esac; \
    apk add --no-cache curl tar; \
    base="https://github.com/${LUME_REPO}/releases/download/${LUME_VERSION}"; \
    curl -fsSL --retry 3 --retry-delay 2 -o /tmp/l.tgz "${base}/lume-linux-${carch}-static.tar.gz"; \
    curl -fsSL --retry 3 -o /tmp/l.sha256 "${base}/lume-linux-${carch}-static.sha256"; \
    (cd /tmp && sed "s|lume-linux-${carch}-static.tar.gz|l.tgz|" l.sha256 | sha256sum -c -); \
    mkdir -p /out && tar -xzf /tmp/l.tgz -C /out; \
    install -m 0755 "/out/lume-linux-${carch}-static/bin/lume" /out/lume; \
    /out/lume --version

# ---------- Stage 2: runtime ----------
# alpine 而不是 debian:bookworm-slim。
# 理由与 lume-a2a 相同(那边实测 121MB → 21.8MB): runtime 阶段只需要
# curl + CA 证书 + 一个非 root 用户, 而 debian-slim 带进 97MB 的
# libc6/coreutils/util-linux/perl-base/bash —— 与本项目无关。
#
# 二进制本身是静态的(ldd: "not a dynamic executable"), 所以换成 alpine
# 不影响运行。保留 curl 是硬要求: agent.c:471 用 execlp("curl", ...)
# 把 /react/api/chat 的模型请求交给 curl 子进程(TLS 由 curl 负责)。
# 换成 scratch 会报 "curl exit 7"(找不到命令), 已实测。
#
# adduser 用 -S(系统用户)/-D(不设密码)/-u 10001: 与原来的 useradd 等价,
# uid 必须保持一致 —— compose 里挂载的 .data 属主是按这个 uid 写的。
FROM alpine:3.20 AS runtime
RUN apk add --no-cache curl ca-certificates tzdata \
    && mkdir -p /app \
    && adduser -S -D -H -u 10001 -h /home/lume lume
COPY --from=lume-fetch /out/lume /usr/local/bin/lume
# 不再带 /app/.env.example: 它原本从源码树取, 仅作参考用途(没有任何代码读它),
# 而 release 包不含该文件。要参考配置项直接看 lume 仓的 .env.example。
WORKDIR /app
USER 10001
# scanner 默认 8094 (宿主 compose 映射 18094->8094); docroot ./www 由 app 镜像 COPY。
EXPOSE 8094
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS -m 4 http://127.0.0.1:8094/api/meta >/dev/null || exit 1
CMD ["/usr/local/bin/lume", "scanner.lume"]
