# Lume demo — LLM / agent configuration (.env)
# Loaded at run() by llm_env_init() from the process CWD (the repo root).
# Copy to `.env` and fill in your values to switch /react/api/chat from the
# built-in offline demo engine to a real OpenAI-compatible model.
#
# An empty LLM_API_KEY selects the offline demo engine (canned answers,
# streamed over SSE). Tests force `LLM_API_KEY=` exported so `make test`
# never talks to a real model even if a .env exists.

# OpenAI-compatible base URL (OpenAI, vLLM, Ollama, LM Studio, ...).
#LLM_API_URL=https://api.openai.com/v1

# Model name as exposed by that endpoint.
#LLM_MODEL=gpt-4o-mini

# API key (never commit a real one).
#LLM_API_KEY=sk-...

# Upstream timeout in seconds (default 60).
#LLM_TIMEOUT=60

# Server settings (.env is loaded before run(), so these act as fallbacks for
# `server { ... }` fields you leave out). A literal in the .lume file always
# wins; unset here -> the framework default (port 18080, fork-per-connection,
# docroot ./www).
#PORT=8081
#WORKERS=8
#DOCROOT=./www

# ---- Basic Auth (docker compose containers only; ignored by `make invest`) ----
# The image entrypoint turns LUME_AUTH_PASSWORD into /app/auth/htpasswd
# (bcrypt) at container start; the server reads it via `htpasswd =
# env("HTPASSWD_FILE")` in server{}. Empty password -> no file -> auth off.
# After editing, run `docker compose up -d` to apply.
# Keep these free of #, $, !, ;, &, quotes and backslash: the value is read by
# both docker compose's env parser and llm_env_init(), and quoting rules
# disagree between them. alnum only is safe for all of them.
#LUME_AUTH_USER=admin
#LUME_AUTH_PASSWORD=change-me
# ---- Invest 设置端点 (iquest /api/settings) ----
# 设置页把 PSE_ALLOW_PAID / PSE_REVIEW_PROVIDER 写回 IQUEST_ENV_FILE 指向的
# .env(审批闸门 dotenvValue 的读取源)。未配置时设置页**写回被拒绝**(500,
# 只读展示不受影响);周报归档读 IQUEST_REPORTS_DIR,缺省 .data/reports。
# IQUEST_ENV_FILE 未设置时 GET /api/settings 只报 "未配置",不泄露任何路径。
#IQUEST_ENV_FILE=/path/to/autogen-pse/.env
#IQUEST_REPORTS_DIR=.data/reports
